			for k, v in pairs(cfg.farm) do
				if type(v) == "boolean" then cfg.farm[k] = false end
			end
			for _, fn in ipairs(cleanups) do pcall(fn) end
			for _, c in ipairs(conns) do c:Disconnect() end
			gui:Destroy()
			if onClosed then onClosed() end
		end
		actionButton(sp, "Unload GUI", OFF_COLOR, unload)
		closeBtn.MouseButton1Click:Connect(unload)
	end

	------------------------------------------------------------ Main loop + keybinds
	connect(RunService.RenderStepped, function(dt)
		local base = os.clock() * cfg.ui.rainbowSpeed
		for _, p in ipairs(rainbowPickers) do
			if p.on then p.apply(Color3.fromHSV((base + p.offset) % 1, 1, 1)) end
		end
		updateSnow(dt)
	end)

	connect(UIS.InputBegan, function(input, gp)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			local cb = listening
			listening = nil
			cb(input.KeyCode)
			return
		end
		if gp then return end
		if input.KeyCode == cfg.ui.toggleKey then
			gui.Enabled = not gui.Enabled
		elseif input.KeyCode == cfg.ui.minKey then
			if main.Visible then minimize() else restore() end
		end
	end)

	-- startup preset: rainbow flags + refresh now that the UI exists
	if startupData then refreshAllUi() end
	dirty = false

	selectTab("Farm")

	return {
		gui = gui,
		show = function() gui.Enabled = true end,
		ctx = ctx,
	}
end

