	},
	{
		id = "BrainrotHeads",
		label = "Brainrot Heads",
		title = "LSW - Brainrot Heads",
		farm = brainrotFarm,
	},
}

local hubConns = {}
local hubGui = Instance.new("ScreenGui")
hubGui.Name = "LSWHUB_Launcher"
hubGui.ResetOnSpawn = false
hubGui.DisplayOrder = 20
hubGui.Parent = playerGui

local hubFrame = Instance.new("Frame")
hubFrame.Size = UDim2.fromOffset(280, 232)
hubFrame.Position = UDim2.new(0.5, -140, 0.5, -116)
hubFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
hubFrame.BorderSizePixel = 0
hubFrame.Parent = hubGui
round(hubFrame, 10)

local hubTitleBar = Instance.new("Frame")
hubTitleBar.Size = UDim2.new(1, 0, 0, 34)
hubTitleBar.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
hubTitleBar.BorderSizePixel = 0
hubTitleBar.Parent = hubFrame
round(hubTitleBar, 10)

local hubTitle = makeLabel(hubTitleBar, "LSW Hub", UDim2.new(1, -50, 1, 0), UDim2.new(0, 12, 0, 0))
hubTitle.Font = Enum.Font.GothamBold
hubTitle.TextSize = 15

local hubClose = makeButton(hubTitleBar, "X", UDim2.fromOffset(28, 24), UDim2.new(1, -34, 0, 5), OFF_COLOR)
hubClose.MouseButton1Click:Connect(function()
	for _, c in ipairs(hubConns) do c:Disconnect() end
	hubGui:Destroy()
end)

makeDraggable(function(sig, fn)
	local c = sig:Connect(fn)
	hubConns[#hubConns + 1] = c
	return c
end, hubTitleBar, hubFrame)

local hint = makeLabel(hubFrame, "Pick a game", UDim2.new(1, -20, 0, 20), UDim2.new(0, 10, 0, 40))
hint.TextSize = 12
hint.TextColor3 = Color3.fromRGB(160, 160, 175)

local panels = {}
for i, g in ipairs(GAMES) do
	local b = makeButton(hubFrame, g.label, UDim2.new(1, -24, 0, 44), UDim2.new(0, 12, 0, 64 + (i - 1) * 52))
	b.TextSize = 15
	b.MouseButton1Click:Connect(function()
		if g.run then
			if b.Text ~= g.label then return end -- already loading
			b.Text = g.label .. " (loading...)"
			task.spawn(function()
				local ok, err = pcall(g.run)
				if not ok then warn("[LSW] " .. tostring(err)) end
				b.Text = g.label .. (ok and " (loaded)" or " (failed)")
				task.wait(2)
				b.Text = g.label
			end)
			return
		end
		local existing = panels[g.id]
		if existing and existing.gui and existing.gui.Parent then
			existing.gui.Enabled = not existing.gui.Enabled
			return
		end
		panels[g.id] = buildPanel(g, function() panels[g.id] = nil end)
	end)
end
