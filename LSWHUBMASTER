	------------------------------------------------------------ Presets
	local presetStatus
	local function setPresetStatus(s)
		if presetStatus then presetStatus.Text = s end
	end
	local function cleanName(name)
		name = tostring(name or ""):match("^%s*(.-)%s*$")
		if name == "" then name = "default" end
		return name
	end
	local function listNames(blob)
		local names = {}
		for n in pairs(blob.presets) do names[#names + 1] = n end
		table.sort(names)
		return #names > 0 and table.concat(names, ", ") or "none"
	end

	local function refreshAllUi()
		main.Size = SIZES[cfg.ui.size] or SIZES.Medium
		setSnowAmount(cfg.snow.amount)
		for _, fn in ipairs(refreshFns) do fn() end
		themeChanged()
	end

	local function savePreset(name, silent)
		name = cleanName(name)
		local blob = readBlob()
		blob.presets[name] = snapshot()
		blob.startup = name
		local ok = writeBlob(blob)
		if ok then
			if not silent then setPresetStatus("saved '" .. name .. "' (loads on start) | presets: " .. listNames(blob)) end
		else
			dirty = true
			setPresetStatus(canSave and "SAVE FAILED" or "SAVE FAILED - no writefile in this environment")
		end
		return ok
	end

	local function loadPreset(name)
		name = cleanName(name)
		local blob = readBlob()
		local data = blob.presets[name]
		if type(data) ~= "table" then
			setPresetStatus("no preset '" .. name .. "' | presets: " .. listNames(blob))
			return
		end
		cfg.preset.name = name
		applySettings(data.settings)
		pendingRainbow = type(data.rainbow) == "table" and data.rainbow or {}
		refreshAllUi()
		setPresetStatus("loaded '" .. name .. "'")
	end

	local function deletePreset(name)
		name = cleanName(name)
		local blob = readBlob()
		if blob.presets[name] == nil then
			setPresetStatus("no preset '" .. name .. "' | presets: " .. listNames(blob))
			return
		end
		blob.presets[name] = nil
		if blob.startup == name then blob.startup = nil end
		if writeBlob(blob) then
			setPresetStatus("deleted '" .. name .. "' | presets: " .. listNames(blob))
		else
			setPresetStatus("DELETE FAILED")
		end
	end

	local lastAuto = 0
	connect(RunService.Heartbeat, function()
		if not dirty or not cfg.preset.autoSave or not canSave then return end
		local now = os.clock()
		if now - lastAuto < 10 then return end
		lastAuto = now
