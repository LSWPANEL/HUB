-- LSW Hub Launcher v1
-- LocalScript -> StarterPlayer > StarterPlayerScripts
-- A small rectangle with 3 buttons: Egg Farm Simulator | Sniper Arena | Brainrot Heads
-- Egg Farm Simulator / Brainrot Heads open their own panel with tabs: Farm | Colors | Settings
-- Sniper Arena button -> loads the LSW Hub loadstring directly (no panel).
-- Brainrot Heads Farm tab: Equip Best, Claim Rewards, Auto Collect Money (pads 1-36), Speed, Fly, Noclip.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local lp = Players.LocalPlayer
local playerGui = lp:WaitForChild("PlayerGui")

for _, g in ipairs(playerGui:GetChildren()) do
	if string.sub(g.Name, 1, 7) == "LSWHUB_" then g:Destroy() end
end

local SIZES = {
	Small = UDim2.fromOffset(340, 400),
	Medium = UDim2.fromOffset(400, 460),
	Large = UDim2.fromOffset(480, 560),
}
local OFFGREY = Color3.fromRGB(70, 70, 80)
local ON_COLOR = Color3.fromRGB(60, 180, 90)
local OFF_COLOR = Color3.fromRGB(180, 60, 60)

local SNIPER_ARENA_URL = "https://raw.githubusercontent.com/LSWPANEL/LSW_Hub/refs/heads/main/LswHub"

---------------------------------------------------------------- Shared helpers
local function round(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = obj
end

local function makeButton(parent, text, size, pos, color)
	local b = Instance.new("TextButton")
	b.Text = text
	b.Size = size
	b.Position = pos or UDim2.new()
	b.BackgroundColor3 = color or Color3.fromRGB(90, 120, 255)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.Parent = parent
	round(b)
	return b
end

local function makeLabel(parent, text, size, pos)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size or UDim2.new(1, -20, 0, 30)
	l.Position = pos or UDim2.new(0, 10, 0, 2)
	l.Text = text
	l.TextColor3 = Color3.fromRGB(235, 235, 235)
	l.Font = Enum.Font.GothamMedium
	l.TextSize = 13
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function makeDraggable(connect, handle, target, onClick)
	local dragging, startPos, startMouse, moved
	connect(handle.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startMouse = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if not moved and onClick then onClick() end
				end
			end)
		end
	end)
	connect(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startMouse
			if d.Magnitude > 4 then moved = true end
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
end

-- color slider: white -> full rainbow -> black
local WHITE_END, BLACK_START = 0.07, 0.93
local function colorAt(t)
	t = math.clamp(t, 0, 1)
	if t < WHITE_END then
		return Color3.new(1, 1, 1):Lerp(Color3.fromHSV(0, 1, 1), t / WHITE_END)
	elseif t > BLACK_START then
		return Color3.fromHSV(0.92, 1, 1):Lerp(Color3.new(0, 0, 0), (t - BLACK_START) / (1 - BLACK_START))
	end
	return Color3.fromHSV((t - WHITE_END) / (BLACK_START - WHITE_END) * 0.92, 1, 1)
end

local SLIDER_SEQ
do
	local kp = { ColorSequenceKeypoint.new(0, colorAt(0)) }
	for i = 0, 14 do
		local t = WHITE_END + (BLACK_START - WHITE_END) * (i / 14)
		kp[#kp + 1] = ColorSequenceKeypoint.new(math.min(t, 0.999), colorAt(t))
	end
	kp[#kp + 1] = ColorSequenceKeypoint.new(1, colorAt(1))
	SLIDER_SEQ = ColorSequence.new(kp)
end

local function posForColor(c)
	local best, bestD = 0, math.huge
	for i = 0, 240 do
		local t = i / 240
		local cc = colorAt(t)
		local d = (cc.R - c.R) ^ 2 + (cc.G - c.G) ^ 2 + (cc.B - c.B) ^ 2
		if d < bestD then best, bestD = t, d end
	end
	return best
end

-- preset value encoding
local function encodeValue(v)
	local t = typeof(v)
	if t == "Color3" then return { c = v:ToHex() } end
	if t == "EnumItem" then return { k = v.Name } end
	return v
end

local function decodeValue(saved, default)
	local dt = typeof(default)
	if dt == "Color3" then
		if type(saved) == "table" and type(saved.c) == "string" then
			local ok, c = pcall(Color3.fromHex, saved.c)
			if ok and typeof(c) == "Color3" then return c end
		end
		return nil
	elseif dt == "EnumItem" then
		if type(saved) == "table" and type(saved.k) == "string" then
			local ok, item = pcall(function() return Enum.KeyCode[saved.k] end)
			if ok and item then return item end
		end
		return nil
	elseif type(saved) == dt then
		return saved
	end
	return nil
end

---------------------------------------------------------------- Panel factory
-- def = { id = "...", title = "...", farm = function(ctx) ... end }
local function buildPanel(def, onClosed)
	local conns = {}
	local function connect(signal, fn)
		local c = signal:Connect(fn)
		conns[#conns + 1] = c
		return c
	end

	local cfg = {
		ui = {
			accent = Color3.fromRGB(90, 120, 255),
			secondary = Color3.fromRGB(45, 45, 58),
			secondaryTransparency = 0,
			background = Color3.fromRGB(28, 28, 34),
			transparency = 0,
			rainbowSpeed = 0.2,
			size = "Medium",
			toggleKey = Enum.KeyCode.RightShift,
			minKey = Enum.KeyCode.RightControl,
		},
		snow = {
			enabled = true,
			amount = 45,
			speed = 1,
			size = 1,
			color = Color3.fromRGB(235, 245, 255),
		},
		farm = {
			equipLoop = false,
			claimLoop = false,
			collectLoop = false,
			loopDelay = 1,
			speedOn = false,
			speedValue = 40,
			fly = false,
			flySpeed = 60,
			noclip = false,
		},
		preset = {
			name = "default",
			autoSave = true,
		},
	}

	local defaults = {}
	for _, t in pairs(cfg) do
		local copy = {}
		for k, v in pairs(t) do copy[k] = v end
		defaults[t] = copy
	end
	local function defaultOf(tbl, key) return defaults[tbl][key] end

	local rainbowPickers, accentFns, resetFns, refreshFns, surfaceObjs = {}, {}, {}, {}, {}
	local dirty = false
	local function markDirty() dirty = true end

	------------------------------------------------------------ Storage (executor file)
	local fileName = "LSWHub_" .. def.id .. ".json"
	local env = getfenv()
	local wf, rf, isf = env.writefile, env.readfile, env.isfile
	local canSave = typeof(wf) == "function" and typeof(rf) == "function"
	local SECTIONS = { "ui", "snow", "farm" }
	-- on/off switches are never restored from a preset, so nothing starts by itself
	local NO_SAVE = { equipLoop = true, claimLoop = true, collectLoop = true, speedOn = true, fly = true, noclip = true }

	local function readBlob()
		if canSave then
			if typeof(isf) == "function" then
				local ok, exists = pcall(isf, fileName)
				if ok and not exists then return { presets = {} } end
			end
			local ok, raw = pcall(rf, fileName)
			if ok and type(raw) == "string" and raw ~= "" then
				local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok2 and type(data) == "table" then
					if type(data.presets) ~= "table" then data.presets = {} end
					return data
				end
			end
		end
		return { presets = {} }
	end

	local function writeBlob(blob)
		if not canSave then return false end
		local ok, str = pcall(function() return HttpService:JSONEncode(blob) end)
		if not ok then return false end
		return (pcall(wf, fileName, str))
	end

	local pendingRainbow = {}
	local function applySettings(settings)
		if type(settings) ~= "table" then return end
		for _, sec in ipairs(SECTIONS) do
			local s = settings[sec]
			if type(s) == "table" then
				for k, saved in pairs(s) do
					local cur = cfg[sec][k]
					if cur ~= nil then
						if not (sec == "farm" and NO_SAVE[k]) then
							local v = decodeValue(saved, cur)
							if v ~= nil then cfg[sec][k] = v end
						end
					end
				end
			end
		end
	end

	local function snapshot()
		local out = { settings = {}, rainbow = {} }
		for _, sec in ipairs(SECTIONS) do
			local s = {}
			for k, v in pairs(cfg[sec]) do
				if not (sec == "farm" and NO_SAVE[k]) then s[k] = encodeValue(v) end
			end
			out.settings[sec] = s
		end
		for i, p in ipairs(rainbowPickers) do out.rainbow[i] = p.on end
		return out
	end

	local startupBlob = readBlob()
	local startupData
	if type(startupBlob.startup) == "string" and type(startupBlob.presets[startupBlob.startup]) == "table" then
		startupData = startupBlob.presets[startupBlob.startup]
		cfg.preset.name = startupBlob.startup
		applySettings(startupData.settings)
		if type(startupData.rainbow) == "table" then pendingRainbow = startupData.rainbow end
	end

	------------------------------------------------------------ Theme
	local function bindAccent(fn)
		accentFns[#accentFns + 1] = fn
		fn(cfg.ui.accent)
	end

	local function surfaceColor(kind)
		if kind == "bg" then return cfg.ui.background end
		if kind == "sec" then return cfg.ui.secondary end
		return cfg.ui.background:Lerp(Color3.new(0, 0, 0), 0.35)
	end
	local function applySurface(obj, kind)
		obj.BackgroundColor3 = surfaceColor(kind)
		if kind == "sec" then
			obj.BackgroundTransparency = cfg.ui.secondaryTransparency
		elseif kind == "bg" then
			obj.BackgroundTransparency = cfg.ui.transparency
		end
	end
	local function surface(obj, kind)
		surfaceObjs[#surfaceObjs + 1] = { obj, kind }
		applySurface(obj, kind)
		return obj
	end

	------------------------------------------------------------ Window
	local gui = Instance.new("ScreenGui")
	gui.Name = "LSWHUB_" .. def.id
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	local main = Instance.new("Frame")
	main.Size = SIZES[cfg.ui.size] or SIZES.Medium
	main.Position = UDim2.new(0.5, -200, 0.5, -230)
	main.BorderSizePixel = 0
	main.Parent = gui
	surface(main, "bg")
	round(main, 10)

	-- snowfall (behind everything: ZIndex 0)
	local setSnowAmount, updateSnow
	do
		local snowFrame = Instance.new("Frame")
		snowFrame.Name = "Snow"
		snowFrame.BackgroundTransparency = 1
		snowFrame.Size = UDim2.new(1, 0, 1, 0)
		snowFrame.ClipsDescendants = true
		snowFrame.ZIndex = 0
		snowFrame.Parent = main

		local flakes = {}
		local lastColor = nil

		local function bounds()
			local w, h = snowFrame.AbsoluteSize.X, snowFrame.AbsoluteSize.Y
			if w < 10 or h < 10 then
				local s = SIZES[cfg.ui.size] or SIZES.Medium
				w, h = s.X.Offset, s.Y.Offset
			end
			return w, h
		end

		local function newFlake()
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = cfg.snow.color
			f.ZIndex = 0
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = f
			f.Parent = snowFrame
			local w, h = bounds()
			f.BackgroundTransparency = math.random(5, 45) / 100
			flakes[#flakes + 1] = {
				frame = f,
				x = math.random() * w,
				y = math.random() * h,
				speed = math.random(25, 70),
				size = math.random(20, 50) / 10,
				phase = math.random() * 6.28,
				drift = math.random(8, 22),
			}
		end

		function setSnowAmount(n)
			while #flakes < n do newFlake() end
			while #flakes > n do
				local d = table.remove(flakes)
				d.frame:Destroy()
			end
		end

		function updateSnow(dt)
			local S = cfg.snow
			local visible = S.enabled and main.Visible
			snowFrame.Visible = visible
			if not visible then return end
			local w, h = bounds()
			local t = os.clock()
			local recolor = (lastColor ~= S.color)
			for _, d in ipairs(flakes) do
				d.y += d.speed * S.speed * dt
				d.x += math.sin(t + d.phase) * d.drift * dt
				if d.y > h + 6 then
					d.y = -6
					d.x = math.random() * w
				end
				if d.x > w + 6 then d.x = -6 elseif d.x < -6 then d.x = w + 6 end
				local sz = d.size * S.size
				d.frame.Size = UDim2.fromOffset(sz, sz)
				d.frame.Position = UDim2.fromOffset(d.x, d.y)
				if recolor then d.frame.BackgroundColor3 = S.color end
			end
			lastColor = S.color
		end

		setSnowAmount(cfg.snow.amount)
	end

	local closeBtn, minimize, restore
	do
		local titleBar = Instance.new("Frame")
		titleBar.Size = UDim2.new(1, 0, 0, 34)
		titleBar.BorderSizePixel = 0
		titleBar.Parent = main
		surface(titleBar, "sec")
		round(titleBar, 10)

		local title = makeLabel(titleBar, def.title, UDim2.new(1, -90, 1, 0), UDim2.new(0, 12, 0, 0))
		title.Font = Enum.Font.GothamBold
		title.TextSize = 15

		local minBtn = makeButton(titleBar, "-", UDim2.fromOffset(28, 24), UDim2.new(1, -66, 0, 5), Color3.fromRGB(200, 160, 50))
		closeBtn = makeButton(titleBar, "X", UDim2.fromOffset(28, 24), UDim2.new(1, -34, 0, 5), OFF_COLOR)

		local block = Instance.new("TextButton")
		block.Size = UDim2.fromOffset(56, 56)
		block.Text = "LSW"
		block.TextColor3 = Color3.new(1, 1, 1)
		block.Font = Enum.Font.GothamBlack
		block.TextSize = 18
		block.AutoButtonColor = false
		block.Visible = false
		block.Parent = gui
		round(block, 10)
		bindAccent(function(c) block.BackgroundColor3 = c end)

		function minimize()
			block.Position = main.Position
			main.Visible = false
			block.Visible = true
		end
		function restore()
			main.Position = block.Position
			block.Visible = false
			main.Visible = true
		end
		minBtn.MouseButton1Click:Connect(minimize)
		makeDraggable(connect, titleBar, main)
		makeDraggable(connect, block, block, restore)
	end

	------------------------------------------------------------ Tabs
	local tabs = {}
	local currentTab = nil
	local function selectTab(name)
		for n, t in pairs(tabs) do
			t.page.Visible = (n == name)
			if n == name then
				t.btn.BackgroundColor3 = cfg.ui.accent
				t.btn.BackgroundTransparency = 0
			else
				t.btn.BackgroundColor3 = cfg.ui.secondary
				t.btn.BackgroundTransparency = cfg.ui.secondaryTransparency
			end
		end
		currentTab = name
	end

	local function themeChanged()
		for _, s in ipairs(surfaceObjs) do applySurface(s[1], s[2]) end
		for _, f in ipairs(accentFns) do f(cfg.ui.accent) end
		if currentTab then selectTab(currentTab) end
	end

	do
		local tabNames = { "Farm", "Colors", "Settings" }
		local tabBar = Instance.new("Frame")
		tabBar.Size = UDim2.new(1, -20, 0, 28)
		tabBar.Position = UDim2.new(0, 10, 0, 40)
		tabBar.BackgroundTransparency = 1
		tabBar.Parent = main

		for i, name in ipairs(tabNames) do
			local btn = makeButton(tabBar, name, UDim2.new(1 / #tabNames, -4, 1, 0),
				UDim2.new((i - 1) / #tabNames, 0, 0, 0))
			btn.TextScaled = true
			local limit = Instance.new("UITextSizeConstraint")
			limit.MaxTextSize = 13
			limit.Parent = btn

			local page = Instance.new("ScrollingFrame")
			page.Size = UDim2.new(1, -20, 1, -80)
			page.Position = UDim2.new(0, 10, 0, 74)
			page.BackgroundTransparency = 1
			page.BorderSizePixel = 0
			page.ScrollBarThickness = 5
			page.CanvasSize = UDim2.new()
			page.AutomaticCanvasSize = Enum.AutomaticSize.Y
			page.Visible = false
			page.Parent = main

			local l = Instance.new("UIListLayout")
			l.Padding = UDim.new(0, 6)
			l.SortOrder = Enum.SortOrder.LayoutOrder
			l.Parent = page

			tabs[name] = { page = page, btn = btn }
			btn.MouseButton1Click:Connect(function() selectTab(name) end)
		end
	end

	------------------------------------------------------------ Controls
	local orderCounter = 0
	local function row(page, h, noSurface)
		orderCounter += 1
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, -8, 0, h or 34)
		f.BorderSizePixel = 0
		f.LayoutOrder = orderCounter
		f.Parent = page
		if noSurface then
			f.BackgroundTransparency = 1
		else
			surface(f, "sec")
			round(f, 6)
		end
		return f
	end

	local function header(page, text)
		orderCounter += 1
		local l = makeLabel(page, text, UDim2.new(1, -8, 0, 24))
		l.Font = Enum.Font.GothamBold
		l.TextSize = 14
		l.LayoutOrder = orderCounter
		bindAccent(function(c) l.TextColor3 = c end)
	end

	local function toggle(page, text, tbl, key, onChange)
		local f = row(page)
		makeLabel(f, text, UDim2.new(1, -70, 1, 0), UDim2.new(0, 10, 0, 0))
		local sw = Instance.new("TextButton")
		sw.Text = ""
		sw.Size = UDim2.fromOffset(44, 22)
		sw.Position = UDim2.new(1, -54, 0.5, -11)
		sw.Parent = f
		round(sw, 11)
		local knob = Instance.new("Frame")
		knob.Size = UDim2.fromOffset(18, 18)
		knob.BackgroundColor3 = Color3.new(1, 1, 1)
		knob.Parent = sw
		round(knob, 9)

		local default = defaultOf(tbl, key)
		local function refresh()
			local on = tbl[key]
			sw.BackgroundColor3 = on and cfg.ui.accent or OFFGREY
			knob.Position = on and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
		end
		bindAccent(refresh)
		refreshFns[#refreshFns + 1] = refresh
		local function set(v)
			tbl[key] = v
			refresh()
			markDirty()
			if onChange then onChange(v) end
		end
		sw.MouseButton1Click:Connect(function() set(not tbl[key]) end)
		resetFns[#resetFns + 1] = function() set(default) end
		return set
	end

	local function slider(page, text, tbl, key, min, max, step, onChange)
		local f = row(page, 50)
		local lbl = makeLabel(f, "", UDim2.new(1, -20, 0, 24))
		local hit = Instance.new("TextButton")
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Size = UDim2.new(1, -20, 0, 22)
		hit.Position = UDim2.new(0, 10, 0, 26)
		hit.Parent = f
		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(1, 0, 0, 6)
		bar.Position = UDim2.new(0, 0, 0.5, -3)
		bar.BorderSizePixel = 0
		bar.Parent = hit
		surface(bar, "box")
		round(bar, 3)
		local fill = Instance.new("Frame")
		fill.BorderSizePixel = 0
		fill.Parent = bar
		round(fill, 3)
		bindAccent(function(c) fill.BackgroundColor3 = c end)

		local function set(v, fire)
			v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
			tbl[key] = v
			fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
			lbl.Text = text .. ": " .. tostring(math.floor(v * 100 + 0.5) / 100)
			if fire then
				markDirty()
				if onChange then onChange(v) end
			end
		end
		local default = defaultOf(tbl, key)
		set(tbl[key], false)
		refreshFns[#refreshFns + 1] = function() set(tbl[key], false) end

		local dragging = false
		local function fromX(x)
			local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			set(min + (max - min) * rel, true)
		end
		hit.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				fromX(input.Position.X)
			end
		end)
		connect(UIS.InputChanged, function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)
		connect(UIS.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		resetFns[#resetFns + 1] = function() set(default, true) end
	end

	local function cycle(page, text, tbl, key, options, onChange)
		local f = row(page)
		makeLabel(f, text, UDim2.new(1, -170, 1, 0), UDim2.new(0, 10, 0, 0))
		local btn = makeButton(f, tostring(tbl[key]), UDim2.fromOffset(150, 24), UDim2.new(1, -160, 0.5, -12))
		btn.TextScaled = true
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = 13
		limit.Parent = btn
		surface(btn, "box")
		local default = defaultOf(tbl, key)
		btn.MouseButton1Click:Connect(function()
			local idx = table.find(options, tbl[key]) or 0
			tbl[key] = options[(idx % #options) + 1]
			btn.Text = tbl[key]
			markDirty()
			if onChange then onChange(tbl[key]) end
		end)
		refreshFns[#refreshFns + 1] = function() btn.Text = tostring(tbl[key]) end
		resetFns[#resetFns + 1] = function()
			tbl[key] = default
			btn.Text = default
			markDirty()
			if onChange then onChange(default) end
		end
	end

	local function textInput(page, text, tbl, key, placeholder)
