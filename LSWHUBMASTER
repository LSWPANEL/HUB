			presetStatus.Text = "No writefile here - presets only last this session."
		else
			presetStatus.Text = "No saved preset yet. Press Save."
		end

		header(sp, "Window")
		cycle(sp, "Window Size", cfg.ui, "size", { "Small", "Medium", "Large" }, function(v)
			main.Size = SIZES[v]
		end)
		keybind(sp, "Hide/Show GUI Key", cfg.ui, "toggleKey")
