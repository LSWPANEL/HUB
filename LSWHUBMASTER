local function brainrotFarm(c)
	local page, cfg = c.page, c.cfg
	local F = cfg.farm
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	-------------------------------------------------- remotes
	local container
	local remotes = {}
	local function getContainer()
		if container and container.Parent then return container end
		local ok, res = pcall(function()
			local r = ReplicatedStorage:WaitForChild("packages", 5)
			r = r:WaitForChild("_Index", 5)
			r = r:WaitForChild("littensy_remo@1.5.3", 5)
			r = r:WaitForChild("remo", 5)
			return r:WaitForChild("container", 5)
		end)
		if ok and res then container = res end
		return container
	end

	-- RemoteEvent -> FireServer, RemoteFunction -> InvokeServer
	local function call(name, ...)
		local rem = remotes[name]
		if not rem or not rem.Parent then
			local cont = getContainer()
			rem = cont and cont:WaitForChild(name, 5)
			if not rem then return false end
			remotes[name] = rem
		end
		local args = table.pack(...)
		return (pcall(function()
			if rem:IsA("RemoteFunction") then
				return rem:InvokeServer(table.unpack(args, 1, args.n))
			elseif rem:IsA("RemoteEvent") then
				rem:FireServer(table.unpack(args, 1, args.n))
			end
		end))
	end

	local CLAIMS = {
		"data.discord.claimReward",
		"data.follow.claimReward",
		"data.group.claimReward",
		"data.rewards.claimFreebie",
		"data.rewards.claimFriendReward",
		"data.rewards.claimJoinReward",
		"data.rewards.claimLeaveReward",
		"data.rewards.claimOfflineMoney",
		"data.rewards.claimPlayReward",
		"game.wheels.claimReward",
	}

	local function equipBest()
		call("data.base.equipBestBrainrots")
	end

	local function claimAll()
		for _, name in ipairs(CLAIMS) do task.spawn(call, name) end
	end

	-- pads 1 to 36, one after the other
	local function collectMoney(loopKey)
		for pad = 1, 36 do
			if loopKey and not F[loopKey] then return end
			call("data.base.collectPadMoney", pad)
		end
	end

	-------------------------------------------------- repeat helper
	local running = {}
	local function startLoop(key, fn)
		if running[key] then return end
		running[key] = true
		task.spawn(function()
			while F[key] do
				pcall(fn)
				task.wait(math.max(F.loopDelay, 0.05))
			end
			running[key] = false
		end)
	end

	local function onceButton(text, fn)
		local b = c.actionButton(page, text, Color3.fromRGB(90, 120, 255), function() task.spawn(fn) end)
		c.bindAccent(function(col) b.BackgroundColor3 = col end)
	end

	-------------------------------------------------- UI
	c.header(page, "Brainrot Heads Farm")
	c.slider(page, "Repeat Delay (s)", F, "loopDelay", 0.1, 5, 0.1)

	c.header(page, "Equip Best")
	c.toggle(page, "Auto Equip Best (repeats)", F, "equipLoop", function(on)
		if on then startLoop("equipLoop", equipBest) end
	end)
	onceButton("Equip Best (once)", equipBest)

	c.header(page, "Claim Rewards")
	c.toggle(page, "Auto Claim All (repeats)", F, "claimLoop", function(on)
		if on then startLoop("claimLoop", claimAll) end
	end)
	onceButton("Claim All (once)", claimAll)

	c.header(page, "Money")
	c.toggle(page, "Auto Collect Money (pads 1-36)", F, "collectLoop", function(on)
		if on then startLoop("collectLoop", function() collectMoney("collectLoop") end) end
	end)
	onceButton("Collect Money (once)", function() collectMoney(nil) end)

	c.header(page, "Movement")
	c.toggle(page, "Speed", F, "speedOn")
	c.slider(page, "Walk Speed", F, "speedValue", 16, 200, 1)
	c.toggle(page, "Fly (WASD + Space / Shift)", F, "fly")
	c.slider(page, "Fly Speed", F, "flySpeed", 10, 200, 5)
	c.toggle(page, "Noclip", F, "noclip")

	-------------------------------------------------- speed / fly / noclip
	local flyBV, flyBG
	local origSpeed
	local noclipped = setmetatable({}, { __mode = "k" })

	local function stopFly()
		if flyBV then flyBV:Destroy() flyBV = nil end
		if flyBG then flyBG:Destroy() flyBG = nil end
		local ch = lp.Character
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if h then h.PlatformStand = false end
	end

	local function restoreNoclip()
		for part in pairs(noclipped) do
			if part.Parent then part.CanCollide = true end
		end
		table.clear(noclipped)
	end

	c.connect(RunService.Heartbeat, function()
		local ch = lp.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end

		if F.speedOn then
			if not origSpeed then origSpeed = hum.WalkSpeed end
			if hum.WalkSpeed ~= F.speedValue then hum.WalkSpeed = F.speedValue end
		elseif origSpeed then
			hum.WalkSpeed = origSpeed
			origSpeed = nil
		end

		if F.fly then
			local cam = workspace.CurrentCamera
			if cam then
				if not flyBV or flyBV.Parent ~= root then
					stopFly()
					flyBV = Instance.new("BodyVelocity")
					flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
					flyBV.Velocity = Vector3.zero
					flyBV.Parent = root
					flyBG = Instance.new("BodyGyro")
					flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
					flyBG.P = 1e4
					flyBG.Parent = root
				end
				hum.PlatformStand = true
				local dir = Vector3.zero
				if not UIS:GetFocusedTextBox() then
					local cf = cam.CFrame
					if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
					if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
					if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
				end
				flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * F.flySpeed or Vector3.zero
				flyBG.CFrame = cam.CFrame
			end
		elseif flyBV then
			stopFly()
		end
	end)

	c.connect(RunService.Stepped, function()
		if not F.noclip then
			if next(noclipped) then restoreNoclip() end
			return
		end
		local ch = lp.Character
		if not ch then return end
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") and p.CanCollide then
				noclipped[p] = true
				p.CanCollide = false
			end
		end
	end)

	c.cleanups[#c.cleanups + 1] = function()
		stopFly()
		restoreNoclip()
		local ch = lp.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and origSpeed then hum.WalkSpeed = origSpeed end
	end
end

